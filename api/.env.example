# ──────────────────────────────────────────────────────────
# PHP Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ──────────────────────────────────────────────────────────

# ── Database Configuration (Local Development - XAMPP) ──
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=3306
DB_NAME_LOCAL=abdul_sami_portfolio
DB_USER_LOCAL=root
DB_PASS_LOCAL=

# ── Database Configuration (Live Production) ──
DB_HOST_LIVE=your_live_db_host
DB_PORT_LIVE=3306
DB_NAME_LIVE=your_live_db_name
DB_USER_LIVE=your_live_db_user
DB_PASS_LIVE=your_live_db_password

# ── Cloudinary CDN Configuration ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── Authentication Secrets ──
ADMIN_FALLBACK_PASSWORD=YourStrongPassword
DEMO_SESSION_TOKEN=your_demo_session_token
ADMIN_EMAIL=your_admin_email@example.com
