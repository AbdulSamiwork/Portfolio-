# ──────────────────────────────────────────────────────────
# React Frontend Environment Configuration
# Copy this to .env and fill in your values
# Vite requires all env vars to start with VITE_
# ──────────────────────────────────────────────────────────

# ── API Base URL (leave empty to use Vite proxy /api in dev) ──
VITE_API_URL=

# ── Cloudinary CDN Configuration ──
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── Admin Fallback (for offline/demo mode only) ──
VITE_ADMIN_FALLBACK_PASSWORD=YourStrongPassword
VITE_DEMO_SESSION_TOKEN=your_demo_session_token
VITE_ADMIN_EMAIL=your_email@example.com
