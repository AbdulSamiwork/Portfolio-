
# Core PHP REST API - Apache Configuration & Security

# Enable Apache CGIPassAuth for HTTP Authorization Header Transmission
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
    RewriteCond %{HTTP:X-Auth-Token} ^(.*)
    RewriteRule .* - [E=HTTP_X_AUTH_TOKEN:%1]
</IfModule>

<IfModule mod_authz_core.c>
    CGIPassAuth On
</IfModule>


# Handle CORS and Headers
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Auth-Token"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Prevent directory listings
Options -Indexes
